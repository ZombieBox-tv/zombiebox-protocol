            {
              "$ref": "#/$defs/PlaybackPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "nowPlaying": {
          "$ref": "#/$defs/NowPlaying"
        }
      },
      "required": ["enabled", "provider", "plan"],
      "additionalProperties": true
    },
