                "type": "boolean"
              },
              "provider": {
                "type": "string"
              }
            },
            "required": ["mode", "live", "provider"],
            "additionalProperties": false
          }
        },
        "recentFailures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
