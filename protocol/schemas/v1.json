              },
              "at": {
                "type": "integer"
              }
            },
            "required": ["provider", "state", "at"],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hardware": {
          "type": "object",
          "properties": {
            "cores": {
              "type": "integer"
            },
            "physicalMb": {
              "type": "integer"
            },
            "storageFreeMb": {
              "type": "integer"
            },
            "glesVersion": {
              "type": "integer"
            },
            "gatewayLatencyMs": {
              "type": "integer"
            },
            "decoderCount": {
              "type": "integer"
            },
            "network": {
              "type": "string"
            },
            "nativeDial": {
              "type": "string"
            },
            "multicast": {
              "type": "string"
            }
          },
          "required": [
            "cores",
            "physicalMb",
            "storageFreeMb",
            "glesVersion",
            "gatewayLatencyMs",
            "decoderCount",
            "network",
            "nativeDial",
            "multicast"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "reportVersion",
        "createdAt",
        "gateway",
        "client",
        "probes",
        "modules",
        "activePlayback",
        "recentFailures",
        "limitations"
      ],
      "additionalProperties": true
    }
  }
}
