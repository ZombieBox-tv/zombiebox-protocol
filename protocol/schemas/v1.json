                "type": ["array", "null"],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["id", "state", "features"],
            "additionalProperties": false
          }
        },
        "activePlayback": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": {
