        "language": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "default": {
          "type": "boolean"
        },
        "forced": {
          "type": "boolean"
        },
        "selectable": {
          "type": "boolean"
        }
      },
      "required": ["id", "kind", "language", "title", "default", "forced", "selectable"],
      "additionalProperties": true
    },
