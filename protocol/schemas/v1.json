{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Version 1 implementation checkpoint. See protocol/compatibility.md for implemented boundaries.",
  "$defs": {
    "Health": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "apiVersion": {
          "const": 1
        }
      },
      "required": ["status", "apiVersion"],
      "additionalProperties": true
    },
    "DeviceRegistration": {
      "type": "object",
      "properties": {
        "clientVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "const": 1
        },
        "platform": {
          "type": "object",
          "properties": {
            "androidApi": {
              "type": "integer",
              "minimum": 9
            },
            "release": {
              "type": "string"
            },
            "manufacturer": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "abis": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["androidApi"],
          "additionalProperties": true
        },
        "display": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            },
            "dpi": {
              "type": "integer",
              "minimum": 0
            },
            "touch": {
              "type": "boolean"
            },
            "dpad": {
              "type": "boolean"
            }
          },
          "required": ["width", "height"],
          "additionalProperties": true
        },
        "memory": {
          "type": "object",
          "properties": {
            "physicalMb": {
              "type": "integer",
              "minimum": 0
            },
            "memoryClassMb": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "installationId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,80}$"
        },
        "pairingCode": {
          "type": "string"
        },
        "hardware": {
          "$ref": "#/$defs/HardwareReport"
        }
      },
      "required": ["clientVersion", "protocolVersion", "platform", "installationId", "pairingCode"],
      "additionalProperties": true
    },
    "DeviceCapabilities": {
      "type": "object",
      "properties": {
        "capabilitiesVersion": {
          "const": 1
        },
        "deviceId": {
          "type": "string"
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": ["PASS", "FAIL", "UNKNOWN"]
              },
              "prepareMs": {
                "type": "integer",
                "minimum": 0
              },
              "firstFrameMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              },
              "positionMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              },
              "completed": {
                "type": "boolean"
              },
              "droppedOrStalled": {
                "type": "boolean"
              }
            },
            "required": ["id", "status"],
            "additionalProperties": true
          }
        },
        "suiteVersion": {
          "type": "integer",
          "minimum": 1
        },
        "cacheKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["capabilitiesVersion", "deviceId", "probes"],
      "additionalProperties": true
    },
    "MediaItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "browseId": {
          "type": "string",
          "maxLength": 100
        },
        "playable": {
          "type": "boolean"
        },
        "guideState": {
          "type": "string",
          "enum": ["FRESH", "STALE", "UNAVAILABLE"]
        }
      },
      "required": ["id", "provider", "kind", "title"],
      "additionalProperties": true
    },
    "HeroModel": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/MediaItem"
        },
        "description": {
          "type": "string"
        },
        "backdropUrl": {
          "type": "string"
        }
      },
      "required": ["item"],
      "additionalProperties": true
    },
    "SectionModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MediaItem"
          }
        }
      },
      "required": ["id", "type"],
      "additionalProperties": true
    },
    "ScreenModel": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "uiSchemaVersion": {
          "const": 1
        },
        "hero": {
          "$ref": "#/$defs/HeroModel"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionModel"
          }
        },
        "screen": {
          "type": "string"
        }
      },
      "required": ["apiVersion", "uiSchemaVersion", "screen", "sections"],
      "additionalProperties": true
    },
    "SubtitleTrack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": ["id", "language", "format"],
      "additionalProperties": true
    },
    "AudioTrack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "codec": {
          "type": "string"
        }
      },
      "required": ["id", "language"],
      "additionalProperties": true
    },
    "PlaybackPlan": {
      "type": "object",
      "properties": {
        "playbackVersion": {
          "const": 1
        },
        "sessionId": {
          "type": "string"
        },
        "mode": {
          "enum": ["DIRECT_PLAY", "REMUX", "TRANSCODE", "EXTERNAL_PLAYER", "LIVE_LOW_LATENCY"]
        },
        "url": {
          "type": "string"
        },
        "live": {
          "type": "boolean"
        },
        "subtitles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubtitleTrack"
          }
        },
        "audioTracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioTrack"
          }
        },
        "mimeType": {
          "type": "string"
        },
        "seekable": {
          "type": "boolean"
        },
        "resumePositionMs": {
          "type": "integer",
          "minimum": 0
        },
        "item": {
          "$ref": "#/$defs/MediaItem"
        },
        "timelineOffsetMs": {
          "type": "integer",
          "minimum": 0
        },
        "subtitleId": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "playbackVersion",
        "sessionId",
        "mode",
        "url",
        "mimeType",
        "seekable",
        "resumePositionMs",
        "item"
      ],
      "additionalProperties": true
    },
    "ModuleStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "enum": ["DISABLED", "STARTING", "HEALTHY", "DEGRADED", "FAILED"]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["id", "state"],
      "additionalProperties": true
    },
    "EventEnvelope": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "cursor": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": ["apiVersion", "cursor", "type", "payload"],
      "additionalProperties": true
    },
    "Preferences": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["AUTO", "TV", "DOCKED", "HANDHELD"]
        },
        "uiLanguage": {
          "enum": ["en", "es"]
        },
        "audioLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtitleLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subtitleMode": {
          "enum": ["auto", "off", "forced", "always"]
        },
        "allowCasting": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["mode", "uiLanguage", "audioLanguages", "subtitleLanguages", "subtitleMode"],
      "additionalProperties": true
    },
    "RegistrationResponse": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "uiSchemaVersion": {
          "const": 1
        },
        "playbackVersion": {
          "const": 1
        },
        "capabilitiesVersion": {
          "const": 1
        },
        "deviceId": {
          "type": "string"
        },
        "deviceToken": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pairingRequired": {
          "const": false
        },
        "presentation": {
          "type": "object",
          "properties": {
            "suggestedMode": {
              "enum": ["TV", "HANDHELD"]
            }
          },
          "required": ["suggestedMode"],
          "additionalProperties": true
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        }
      },
      "required": [
        "apiVersion",
        "uiSchemaVersion",
        "playbackVersion",
        "capabilitiesVersion",
        "deviceId",
        "deviceToken",
        "pairingRequired",
        "presentation",
        "preferences"
      ],
      "additionalProperties": true
    },
    "DeviceRecord": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string"
        },
        "registration": {
          "type": "object",
          "properties": {
            "clientVersion": {
              "type": "string"
            },
            "protocolVersion": {
              "const": 1
            },
            "platform": {
              "type": "object",
              "properties": {
                "androidApi": {
                  "type": "integer",
                  "minimum": 9
                },
                "release": {
                  "type": "string"
                },
                "manufacturer": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "abis": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["androidApi"],
              "additionalProperties": true
            },
            "display": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "minimum": 0
                },
                "dpi": {
                  "type": "integer",
                  "minimum": 0
                },
                "touch": {
                  "type": "boolean"
                },
                "dpad": {
                  "type": "boolean"
                }
              },
              "required": ["width", "height"],
              "additionalProperties": true
            },
            "memory": {
              "type": "object",
              "properties": {
                "physicalMb": {
                  "type": "integer",
                  "minimum": 0
                },
                "memoryClassMb": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": true
            },
            "installationId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{8,80}$"
            },
            "pairingCode": {
              "type": "string"
            }
          },
          "required": ["clientVersion", "protocolVersion", "platform", "installationId"],
          "additionalProperties": true
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        },
        "capabilities": {
          "$ref": "#/$defs/DeviceCapabilities"
        }
      },
      "required": ["deviceId", "registration", "preferences", "capabilities"],
      "additionalProperties": true
    },
    "ProviderStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "configured": {
          "type": "boolean"
        },
        "hasToken": {
          "type": "boolean"
        },
        "implemented": {
          "type": "boolean"
        },
        "managedByServer": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "enabled",
        "configured",
        "hasToken",
        "implemented",
        "managedByServer"
      ],
      "additionalProperties": true
    },
    "ProviderStatusResponse": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderStatus"
          }
        }
      },
      "required": ["providers"],
      "additionalProperties": true
    },
    "EventBatch": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "cursor": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventEnvelope"
          }
        }
      },
      "required": ["apiVersion", "cursor", "events"],
      "additionalProperties": true
    },
    "PlaybackRequest": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "mode": {
          "enum": ["AUTO", "DIRECT_PLAY", "REMUX", "TRANSCODE", "EXTERNAL_PLAYER"]
        },
        "positionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "quality": {
          "enum": ["STANDARD", "LOW"]
        }
      },
      "required": ["itemId"],
      "additionalProperties": true
    },
    "CastRequest": {
      "type": "object",
      "properties": {
        "receiverId": {
          "type": "string"
        }
      },
      "required": ["receiverId"],
      "additionalProperties": true
    },
    "CastGrant": {
      "type": "object",
      "properties": {
        "castId": {
          "type": "string"
        },
        "publishPath": {
          "type": "string"
        },
        "publishUser": {
          "type": "string"
        },
        "publishToken": {
          "type": "string"
        },
        "rtspPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "video": {
          "type": "object",
          "properties": {
            "codec": {
              "const": "h264"
            },
            "maxWidth": {
              "type": "integer"
            },
            "maxHeight": {
              "type": "integer"
            },
            "fps": {
              "type": "integer"
            },
            "bitrate": {
              "type": "integer"
            }
          },
          "required": ["codec", "maxWidth", "maxHeight", "fps", "bitrate"],
          "additionalProperties": true
        }
      },
      "required": [
        "castId",
        "publishPath",
        "publishUser",
        "publishToken",
        "rtspPort",
        "leaseSeconds",
        "video"
      ],
      "additionalProperties": true
    },
    "CastReceivers": {
      "type": "object",
      "properties": {
        "relayAvailable": {
          "type": "boolean"
        },
        "receivers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "online": {
                "type": "boolean"
              }
            },
            "required": ["deviceId", "name", "online"],
            "additionalProperties": true
          }
        }
      },
      "required": ["relayAvailable", "receivers"],
      "additionalProperties": true
    },
    "ActiveCast": {
      "type": "object",
      "properties": {
        "plan": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/PlaybackPlan"
            }
          ]
        }
      },
      "required": ["plan"],
      "additionalProperties": true
    },
    "IntegrationStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "full": {
          "type": "string"
        },
        "edge": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": ["id", "provider", "runtime", "implementation", "full", "edge", "state"],
      "additionalProperties": true
    },
    "IntegrationResponse": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "integrations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/IntegrationStatus"
          }
        }
      },
      "required": ["apiVersion", "integrations"],
      "additionalProperties": true
    },
    "NowPlaying": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": ["spotify", "airplay", "auto"]
        },
        "state": {
          "type": "string"
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "positionMs": {
          "type": "integer",
          "minimum": 0
        },
        "item": {
          "$ref": "#/$defs/MediaItem"
        }
      },
      "required": ["provider", "state", "volume", "positionMs"],
      "additionalProperties": true
    },
    "PlayerCommand": {
      "type": "object",
      "properties": {
        "action": {
          "enum": ["pause", "resume", "next", "previous", "stop", "seek", "volume"]
        },
        "positionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["action"],
      "additionalProperties": true
    },
    "AuthorizationPrompt": {
      "type": "object",
      "properties": {
        "state": {
          "enum": ["NONE", "WAITING"]
        },
        "url": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        }
      },
      "required": ["state"],
      "additionalProperties": true
    },
    "BrowserRequest": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": ["url"],
      "additionalProperties": true
    },
    "BrowserSession": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "width": {
          "const": 960
        },
        "height": {
          "const": 540
        },
        "idleSeconds": {
          "const": 90
        }
      },
      "required": ["sessionId", "width", "height", "idleSeconds"],
      "additionalProperties": true
    },
    "BrowserInput": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "navigate",
            "text",
            "key",
            "back",
            "forward",
            "reload",
            "click",
            "move",
            "scroll"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 2048
        },
        "x": {
          "type": "integer",
          "minimum": -960,
          "maximum": 960
        },
        "y": {
          "type": "integer",
          "minimum": -540,
          "maximum": 540
        }
      },
      "required": ["action"],
      "additionalProperties": true
    },
    "ProbeManifest": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "suiteVersion": {
          "type": "integer",
          "minimum": 1
        },
        "probes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^/v1/probes/"
              },
              "video": {
                "type": "boolean"
              },
              "kind": {
                "enum": ["playback", "seek", "pause-resume", "surface-reattach", "hls"]
              }
            },
            "required": ["id", "url", "video"],
            "additionalProperties": true
          }
        },
        "cacheKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["apiVersion", "suiteVersion", "probes"],
      "additionalProperties": true
    },
    "YouTubeReceiverState": {
      "type": "object",
      "properties": {
        "receiverId": {
          "type": "string"
        },
        "state": {
          "enum": ["STARTING", "WAITING", "READY", "UNAVAILABLE"]
        },
        "tvCode": {
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                },
                "action": {
                  "enum": ["play", "pause", "resume", "stop", "seek", "volume"]
                },
                "videoId": {
                  "type": "string"
                },
                "itemId": {
                  "type": "string"
                },
                "positionMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 604800000
                },
                "volume": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "muted": {
                  "type": "boolean"
                }
              },
              "required": ["id", "action"],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["receiverId", "state", "tvCode", "command"],
      "additionalProperties": true
    },
    "ReceiverAcknowledgement": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "state": {
          "enum": ["PLAYING", "PAUSED", "STOPPED", "ENDED", "BUFFERING", "FAILED"]
        },
        "positionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "muted": {
          "type": "boolean"
        }
      },
      "required": ["commandId", "success", "state", "positionMs", "durationMs", "volume", "muted"],
      "additionalProperties": true
    },
    "HardwareReport": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "maxLength": 200
        },
        "device": {
          "type": "string",
          "maxLength": 200
        },
        "network": {
          "type": "string",
          "maxLength": 40
        },
        "scannerVersion": {
          "const": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "keyboard": {
          "type": "boolean"
        },
        "mouse": {
          "type": "boolean"
        },
        "nativeDial": {
          "const": "UNKNOWN"
        },
        "multicast": {
          "const": "UNKNOWN"
        },
        "cpuCores": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "physicalMb": {
          "type": "integer",
          "minimum": 0
        },
        "storageFreeMb": {
          "type": "integer",
          "minimum": 0
        },
        "glesVersion": {
          "type": "integer",
          "minimum": 0
        },
        "gatewayLatencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "abis": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "externalPlayers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "decoders": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "types": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            },
            "required": ["name", "types"],
            "additionalProperties": true
          }
        },
        "integrationHints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "required": [
        "product",
        "device",
        "network",
        "scannerVersion",
        "fingerprint",
        "keyboard",
        "mouse",
        "nativeDial",
        "multicast",
        "cpuCores",
        "physicalMb",
        "storageFreeMb",
        "glesVersion",
        "gatewayLatencyMs",
        "abis",
        "externalPlayers",
        "decoders"
      ],
      "additionalProperties": true
    },
    "MediaTrack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
