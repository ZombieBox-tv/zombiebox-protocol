          "type": "string"
        }
      },
      "required": ["startMs", "endMs", "text"],
      "additionalProperties": true
    },
    "SubtitleCues": {
      "type": "object",
      "properties": {
        "cues": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/SubtitleCue"
          }
        }
      },
      "required": ["cues"],
      "additionalProperties": true
    },
    "AudioSelection": {
      "type": "object",
      "properties": {
        "audioId": {
