                "enum": ["PASS", "FAIL", "UNKNOWN"]
              },
              "prepareMs": {
                "type": "integer",
                "minimum": 0
              },
              "firstFrameMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              },
              "positionMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              },
              "completed": {
                "type": "boolean"
              },
              "droppedOrStalled": {
                "type": "boolean"
              }
            },
            "required": ["id", "status"],
            "additionalProperties": true
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
