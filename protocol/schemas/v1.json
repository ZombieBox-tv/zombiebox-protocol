      "type": "object",
      "properties": {
        "provider": {
          "enum": ["spotify", "airplay", "auto"]
        }
      },
      "required": ["provider"],
      "additionalProperties": true
    },
    "DiagnosticReport": {
      "type": "object",
      "properties": {
        "reportVersion": {
          "const": 1
        },
        "createdAt": {
          "type": "string"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": 1
            },
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "goVersion": {
              "type": "string"
            },
            "localMedia": {
              "type": "boolean"
            },
            "remoteMedia": {
              "type": "boolean"
            }
          },
          "required": ["apiVersion", "os", "arch", "goVersion", "localMedia", "remoteMedia"],
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "platform": {
              "type": "object",
              "properties": {
                "androidApi": {
                  "type": "integer",
                  "minimum": 9
                },
                "release": {
                  "type": "string"
                },
                "manufacturer": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "abis": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["androidApi"],
              "additionalProperties": true
            },
            "display": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "minimum": 0
                },
                "dpi": {
                  "type": "integer",
                  "minimum": 0
                },
                "touch": {
                  "type": "boolean"
                },
                "dpad": {
                  "type": "boolean"
                }
              },
              "required": ["width", "height"],
              "additionalProperties": true
            },
            "memory": {
              "type": "object",
              "properties": {
                "physicalMb": {
                  "type": "integer",
                  "minimum": 0
                },
                "memoryClassMb": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": true
            }
          },
          "required": ["version", "platform", "display", "memory"],
          "additionalProperties": false
        },
        "probes": {
          "type": "array",
